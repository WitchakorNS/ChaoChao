# CHAOCHAO — environment template.
# Copy this file to `.env.local` (which is git-ignored), then paste in your keys:
#   cp .env.sample .env.local
#
# LOCAL setup: run `npx supabase start` — it prints the API URL, the anon key,
# and the service_role key. Paste those values below.
#
# CLOUD setup: get these from your Supabase project → Settings → API.
#
# The URL below is the default for local Supabase (just localhost — not secret).

# --- Public (sent to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<paste the anon / publishable key here>

# --- Server-only (NEVER sent to the browser — no NEXT_PUBLIC_ prefix) ---
# Needed for database writes (create listing, booking, review, …). The anon key
# above only has SELECT grants, so writes use this elevated key.
# NEVER commit the real value of a CLOUD project — keep this a placeholder in git.
SUPABASE_SERVICE_ROLE_KEY=<paste the service_role key here>
